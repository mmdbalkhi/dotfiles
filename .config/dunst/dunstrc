[global]

font = JetBrainsMono Nerd Font 10

width = 300
height = 300
origin = top-right
offset = 20x20

stack_duplicates = true
hide_duplicate_count = false

gap_size = 0`
separator_height = 0

padding = 16
horizontal_padding = 16

corner_radius = 14

icon_position = left
max_icon_size = 48

frame_width = 0
separator_height = 0

# transparency handled by rgba color
transparency = 0

background = "#1a1b26cc"
foreground = "#c0caf5"

timeout = 5
markup = full
format = "<b>%s</b>\n%b"

[urgency_low]
background = "#1a1b26cc"
foreground = "#c0caf5"
timeout = 3

[urgency_normal]
background = "#1a1b26cc"
foreground = "#c0caf5"
timeout = 6

[urgency_critical]
background = "#1a1b26ee"
foreground = "#f7768e"
timeout = 0

