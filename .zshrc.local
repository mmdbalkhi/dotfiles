#!/usr/bin/env zsh
########################
####### EXPORT #########
########################

export ZSH="$HOME/.zsh/"

export HISTORY_IGNORE="(ls|cd|pwd|exit|reboot|poweroff|history|cd -|cd ..|isort .|)"
export EDITOR="kak"              # $EDITOR use Vim in terminal
export VISUAL="kak"           # $VISUAL use Vim in GUI mode
export LANG=en_US.UTF-8
export PATH="$HOME/.cargo/bin:$HOME/.config/emacs/bin:$HOME/go/bin:$HOME/Documents/Study:$HOME/.elan/bin:$PATH"
export GPG_TTY=$(tty)


export HISTORY_IGNORE="(ls|cd|pwd|exit|reboot|poweroff|history|cd -|cd ..|sudo poweroff -f|sudo reboot -f|code|code .|loginctl poweroff|loginctl reboot)"
export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=5000000
export SAVEHIST=5000000

setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_SPACE

#########################
######### PATH ##########
#########################

if [ -d "$HOME/.bin" ] ;
  then PATH="$HOME/.bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ] ;
  then PATH="$HOME/.local/bin:$PATH"
fi

if [ -d "$HOME/Applications" ] ;
  then PATH="$HOME/Applications:$PATH"
fi

if [ -d "$HOME/.cargo/bin" ]
  then PATH="$HOME/.cargo/bin:$PATH"
fi

########################
###### SET VI MODE ######
#########################

# Comment this line out to enable default emacs-like bindings
# bindkey -v

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

##########################
####### functions ########
##########################

SAVEIFS=$IFS
IFS=$(echo -en "")

function extract {
  if [ -z "$1" ]; then
    # display usage if no parameters given
    echo "Usage: extract <path/file_name>.<zip|rar|bz2|gz|tar|tbz2|tgz|Z|7z|xz|ex|tar.bz2|tar.gz|tar.xz>"
    echo "       extract <path/file_name_1.ext> [path/file_name_2.ext] [path/file_name_3.ext]"
  else
    for n in "$@"
    do
      if [ -f "$n" ] ; then
        case "${n%,}" in
          *.cbt|*.tar.bz2|*.tar.gz|*.tar.xz|*.tbz2|*.tgz|*.txz|*.tar)
          tar xvf "$n"       ;;
          *.lzma)      unlzma ./"$n"      ;;
          *.bz2)       bunzip2 ./"$n"     ;;
          *.cbr|*.rar)       unrar x -ad ./"$n" ;;
          *.gz)        gunzip ./"$n"      ;;
          *.cbz|*.epub|*.zip)       unzip ./"$n"       ;;
          *.z)         uncompress ./"$n"  ;;
          *.7z|*.arj|*.cab|*.cb7|*.chm|*.deb|*.dmg|*.iso|*.lzh|*.msi|*.pkg|*.rpm|*.udf|*.wim|*.xar)
          7z x ./"$n"        ;;
          *.xz)        unxz ./"$n"        ;;
          *.exe)       cabextract ./"$n"  ;;
          *.cpio)      cpio -id < ./"$n"  ;;
          *.cba|*.ace)      unace x ./"$n"      ;;
          *)
            echo "extract: '$n' - unknown archive method"
            return 1
          ;;
        esac
      else
        echo "'$n' - file does not exist"
        return 1
      fi
    done
  fi
}

canon() {
    sed \
      -e 's/\r$//' \
      -e 's/[ \t]\+$//' \
      -e :a -e '/^\n*$/{$d;N;ba}' -e '$a\'
}


f0x() {
    local url="$(pass f0x_url)"
    local header="XWHO: $(pass f0x_token)"
    local out

    if [ -t 0 ]; then
        # no stdin
        if [ $# -eq 0 ]; then
            echo "usage:"
            echo "  echo 'text' | paste"
            echo "  paste 'text'"
            echo "  paste file.txt"
            return 1
        fi

        if [ -f "$1" ]; then
            out=$(curl -fsS -H "$header" --data-binary @"$1" "$url") || return 1
        else
            out=$(printf "%s" "$*" | curl -fsS -H "$header" --data-binary @- "$url") || return 1
        fi
    else
        # stdin
        out=$(curl -fsS -H "$header" --data-binary @- "$url") || return 1
    fi

    echo $out
}


ipinfo() {
    curl -s -H "Authorization: Bearer $(pass ipinfo)" https://ipinfo.io/$1 | jq
}

ytdl() {
    local args=()

    args+=(
        # "-N" "3"
        "--js-runtimes" "node"
        "-f" "bestvideo[height=1080][proto*=https]+bestaudio/best[height=1080][proto*=https]/best[height=1080]/best"
        "--embed-subs" "--embed-metadata" "--embed-thumbnail"
        "--merge-output-format" "mkv"
        "-o" "%(playlist)s/%(playlist_index)s - %(title)s [%(uploader)s].%(ext)s"
        "--download-archive" "archive.txt"
        "--cookies-from-browser" "firefox"
        "--proxy" "socks5://127.0.0.1:9050"
    )

    if [ $# -eq 0 ]; then
        echo "usage: ytdl [OPTIONS] URL"
        echo "  A wrapper on yt-dlp :>"
        echo "  examples:"
        echo "    ytdl https://youtu.be/..."
        echo "    ytdl -f 137+140 https://..."
        echo "    ytdl --no-proxy https://..."
        return 1
    fi

    command yt-dlp "${args[@]}" "$@"
}

venv(){
  if [ -f .venv/bin/activate ]; then
    . .venv/bin/activate
  else
	  virtualenv .venv && . .venv/bin/activate
  fi
}

torrentdl(){
  aria2c --continue=true -V --bt-save-metadata=true $@
}

###############
### ALIASES ###
###############

## root privileges
alias doas="doas --"
alias sudo="sudo -p '[SUDO] Sir, Could You Please Enter Your password:' "

## vim
alias vi=vim
alias em="/usr/bin/emacs -nw"
alias emacs="emacsclient -c -a 'emacs'"

## doomemacs
alias doomsync="~/.config/emacs/bin/doom sync"
alias doomdoctor="~/.config/emacs/bin/doom doctor"
alias doomupgrade="~/.config/emacs/bin/doom upgrade"
alias doompurge="~/.config/emacs/bin/doom purge"

## add color to grep(s)
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

## confirm before overwriting something
alias cp="cp -i"
alias mv='mv -i'
alias rm='rm -i'

# alias "l" to exa with icons
alias l='exa -lah --git --icons'

## progress bar in cp/mv
alias cpg="cpg -g"
alias mvg="mvg -g"

## mtp-alias
alias sendphone='mtp-connect --sendfile'

## human-readable sizes
alias free='free -h'
alias df='df -h'
alias du='du -h'

## xdg
alias open='xdg-open'

## Terminals' command

if [ -f `which kitty` ]; then
  ## show img in terminal
  alias icat="kitty +kitten icat"
  
  ## connect via ssh
  alias issh="kitty +kitten ssh"
fi

# youtube-dl

alias youtube-dl="yt-dlp"
alias yta-aac="youtube-dl --extract-audio --audio-format aac "
alias yta-best="youtube-dl --extract-audio --audio-format best "
alias yta-flac="youtube-dl --extract-audio --audio-format flac "
alias yta-m4a="youtube-dl --extract-audio --audio-format m4a "
alias yta-mp3="youtube-dl --extract-audio --audio-format mp3 "
alias yta-opus="youtube-dl --extract-audio --audio-format opus "
alias yta-vorbis="youtube-dl --extract-audio --audio-format vorbis "
alias yta-wav="youtube-dl --extract-audio --audio-format wav "
alias ytv-best="youtube-dl -f bestvideo+bestaudio "

# batman
alias man="batman"

# f0x
alias -g F="| canon |f0x"

alias -g J="| jq"

alias ta='task add +inbox'
alias ti='task +inbox'
alias tn='task +next'
alias tq='task +quick'
alias td='task done'
alias tt='task today'
alias tp='task projects'


# battery
alias battery="upower -i /org/freedesktop/UPower/devices/battery_BAT0"


alias aria2="aria2c -x 16 -s 16 -k 1M -c"

pdownload(){
    while IFS= read -r line; do
        printf '%s\n' "$line"
        aria2 $line
    done < $1
}

## use fzf plugin
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

## plugins
plugins=(git zsh-syntax-highlighting zsh-z)

for _plugin in $plugins; do
	_path="${ZSH}plugins/${_plugin}/${_plugin}.zsh"
	if [ -f $_path ]; then
		source $_path
	else
		_path="${ZSH}plugins/${_plugin}/${_plugin}.plugin.zsh"
		if [ -f $_path ]; then
			source $_path
		else
			echo "[ZSH] plugin ${_plugin} not found."
		fi
	fi
done

## completions
zrcautoload _cargo _niri _rustup _singbox
zstyle ':completion:*' rehash true

precmd() {
  print -Pn "\e]2:zsh\a"
}

preexec() {
  local cmd=${1%% *}
  print -Pn "\e]2:${cmd}\a"
}

# BEGIN opam configuration
# This is useful if you're using opam as it adds:
#   - the correct directories to the PATH
#   - auto-completion for the opam binary
# This section can be safely removed at any time if needed.
[[ ! -r '/home/komeil/.opam/opam-init/init.zsh' ]] || source '/home/komeil/.opam/opam-init/init.zsh' > /dev/null 2> /dev/null
# END opam configuration

[[ -n "$ZSH_WELCOME_LOADED" ]] && return
ZSH_WELCOME_LOADED=1

[[ -f ~/.zsh_welcome ]] && source ~/.zsh_welcome
